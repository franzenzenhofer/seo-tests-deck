{
  "name": "seo-tests-deck",
  "version": "0.2.0",
  "description": "The 3 SEO Tests deck: PageSpeed Insights, JS turned off and Google Search Console live-test screenshots per page type, built into a pdf / pptx / html deck",
  "keywords": [
    "seo",
    "pagespeed-insights",
    "search-console",
    "javascript-seo",
    "playwright",
    "slides",
    "claude-code-skill"
  ],
  "license": "MIT",
  "author": "Franz Enzenhofer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franzenzenhofer/seo-tests-deck.git"
  },
  "type": "module",
  "bin": {
    "seo-tests-deck": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "gates": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "whitedeck": "github:franzenzenhofer/whitedeck"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
